<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:AssignSticker_X.windows.welcomewindow"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="300"
        x:Class="AssignSticker_X.windows.welcomewindow.rootwindow"
        Title="欢迎使用AssignSticker"
        Width="800" Height="600"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <local:welcomepage x:Name="WelcomePage" />
        <local:navigationview x:Name="NavView" IsVisible="False" />
    </Grid>
</Window>