<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AssignSticker_X.windows.settingswindow.view.management.subjectmanag_interface">
    <ScrollViewer>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Width="680">
            <StackPanel Classes="page-container animated-intro">
                <TextBlock Text="学科管理"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <TextBox Name="NewSubjectBox" Width="200" PlaceholderText="输入新学科名称" />
                    <Button Name="AddSubjectBtn" Content="添加学科" FontSize="13" Padding="12,4" />
                </StackPanel>

                <StackPanel Name="SubjectList" Spacing="4" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
