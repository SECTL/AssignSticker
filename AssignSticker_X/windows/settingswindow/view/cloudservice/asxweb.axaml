<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AssignSticker_X.windows.settingswindow.view.cloudservice.asxweb">
    <ScrollViewer>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Width="680" MinHeight="400">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Classes="page-container animated-intro">
                <TextBlock Text="AssignSticker 网页版"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="该板块施工中"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="comming soon"
                           FontSize="14"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
