<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AssignSticker_X.windows.settingswindow.view.cloudservice.asxweb">
    <ScrollViewer VerticalContentAlignment="Stretch">
        <Grid>
            <StackPanel MaxWidth="680" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="AssignSticker 网页版"
                           FontSize="24"
                           FontWeight="Bold" />

                <TextBlock Text="该板块施工中"
                           FontSize="32"
                           FontWeight="Bold" />
                <TextBlock Text="comming soon"
                           FontSize="14"
                           Foreground="Gray"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
