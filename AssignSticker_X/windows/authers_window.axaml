<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AssignSticker_X.windows.authers_window"
        Title="贡献者列表"
        Width="800" Height="600"
        MinWidth="800" MinHeight="628">
    <ScrollViewer>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Width="680">
            <StackPanel Classes="page-container animated-intro">
                <TextBlock Text="贡献者列表"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,20,0,6" />
                <TextBlock Text="组织"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,4" />
                <StackPanel x:Name="GroupContainer" />
                <TextBlock Text="个人"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,4" />
                <StackPanel x:Name="IndividualContainer" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
